	RET

EVENTOS1_5:

     JNB FICHA_TIPO, NORMAL_1
     SETB LED_LINT
     SJMP INTENSIVO_1

     NORMAL_1:
     SETB LED_LNOR

     INTENSIVO_1:
     RET

