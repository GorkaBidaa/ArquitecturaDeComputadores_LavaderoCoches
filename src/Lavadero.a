EVENTOS4_9:
     
     CLR EV_AGUA
     CLR EV_JABON
     ACALL ACTIVAR_TIMER_0; avanza 40cm mas: AQUI SE INICIA UNA TIMER DE 4s (CUANDO PASEN 4s --> IR AL EVENTO 10)
	RET

EVENTOS4_10:
     ACALL DESACTIVAR_TIMER_0
     MOV ESTADO, #0x05
     JB LED_LNOR, LAV_NORMAL_R
     SJMP LAV_INTENSIVO_R

     LAV_NORMAL_R:
     MOV PWM0, #0x80 ; %50 del PWM0
     SJMP RODILLO_ACTIVADO

     LAV_INTENSIVO_R:
     MOV PWM0, #0x00 ; %100 del PWM0



     RODILLO_ACTIVADO:
     SETB RV_INTO
     
	RET

